# ===================================================
# .gitignore — Bot RAG Documents Juridiques Arabes
# ===================================================

# ---- Variables d'environnement (TRÈS IMPORTANT — ne jamais commiter) ----
.env
*.env
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
venv311/
.venv/
ENV/
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
*.pyo

# ---- ChromaDB (base vectorielle locale) ----
backend/chroma_db/

# ---- PDFs uploadés ----
backend/uploads/*
!backend/uploads/9fe1d628-612b-4ee9-b0a5-a1c683820124/
!backend/uploads/9fe1d628-612b-4ee9-b0a5-a1c683820124/2ecfe18a-a9d8-44ed-bceb-46c788e5298d.pdf

# ---- Modèles ML téléchargés (lourds) ----
*.bin
*.safetensors
*.onnx
.cache/
huggingface/

# ---- Logs ----
*.log
logs/

# ---- Node.js (Frontend) ----
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/

# ---- IDEs ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Tests ----
.pytest_cache/
.coverage
htmlcov/

# ---- Fichiers Markdown (Sauf README) ----
*.md
!README.md
!**/README.md
